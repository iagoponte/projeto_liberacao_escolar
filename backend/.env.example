# Copie para backend/.env. Use apenas dados ficticios em desenvolvimento e testes.
DATABASE_URL=postgresql+psycopg://liberacao:troque-esta-senha@localhost:5433/liberacao_dev
# Fuso explicito da escola (Horario de Brasilia). Nunca depende do fuso da maquina.
SCHOOL_TIMEZONE=America/Sao_Paulo
# Banco de TESTE (isolado; o nome deve terminar em _test)
TEST_DATABASE_URL=postgresql+psycopg://liberacao:troque-esta-senha@localhost:5433/liberacao_test

# Segredo da aplicacao (usado no token CSRF). Minimo de 32 caracteres.
# O valor abaixo e curto DE PROPOSITO: a API nao sobe ate voce troca-lo. Gere um com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=TROQUE-ESTE-VALOR

# O cookie de sessao so trafega por HTTPS por padrao. Em desenvolvimento local
# (http://localhost) use false. Em producao, mantenha true.
COOKIE_SECURE=false

# Opcionais (valores padrao entre parenteses):
# SESSION_ABSOLUTE_MINUTES=480      # duracao maxima da sessao (8 horas)
# SESSION_IDLE_MINUTES=30           # expira apos este tempo sem acesso
# LOGIN_MAX_FALHAS=5                # falhas por e-mail antes do bloqueio
# LOGIN_JANELA_MINUTOS=15           # janela de contagem das falhas
# LOGIN_MAX_FALHAS_POR_IP=20        # falhas por IP antes do bloqueio